# =================================================================
# ENVIRONMENT VARIABLES - EXAMPLE CONFIGURATION
# =================================================================
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to version control!
#
# If any secrets have ever been committed to the repository,
# you MUST rotate all affected API keys/secrets immediately.
# =================================================================

# Supabase Configuration (Lovable Cloud auto-populates these)
# These are PUBLIC keys safe for client-side code
VITE_SUPABASE_PROJECT_ID="your-project-id-here"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key-here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional: Site URL for canonical links and SEO (defaults to window.location.origin)
# VITE_SITE_URL="https://yourdomain.com"
